# rocket-track — keep the repo cloneable; full image dumps stay local / Roboflow

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env

# Outputs / caches
outputs/
!outputs/.gitignore
runs/detect/
runs/track/
runs/predict/
*.cache
train/labels.cache
valid/labels.cache
test/labels.cache

# Full Roboflow image dumps (labels kept; see README for re-download)
train/images/
valid/images/
test/images/

# Base YOLO checkpoints (downloaded by ultralytics on demand)
yolov8n.pt
yolov8s.pt
yolo11n.pt

# Large training checkpoints (product weights live under weights/)
runs/train/**/weights/epoch*.pt
runs/train/**/weights/last.pt
